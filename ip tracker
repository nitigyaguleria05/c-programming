import { createFileRoute } from "@tanstack/react-router";
import { useMutation, useQuery } from "@tanstack/react-query";
import { useServerFn } from "@tanstack/react-start";
import { useState } from "react";
import { Globe, MapPin, Search, Signal, Wifi, Clock, Hash, Loader2 } from "lucide-react";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { getMyIp, lookupIp, type IpInfo } from "@/lib/ip.functions";

export const Route = createFileRoute("/")({
  head: () => ({
    meta: [
      { title: "IP Tracker — Trace Any IP Address Location" },
      {
        name: "description",
        content:
          "Instantly see your own public IP address and trace any IP or domain: city, country, ISP, ASN, timezone and coordinates.",
      },
      { property: "og:title", content: "IP Tracker — Trace Any IP Address Location" },
      {
        property: "og:description",
        content:
          "See your public IP and geolocate any IP or domain: city, country, ISP, ASN, timezone and coordinates.",
      },
      { property: "og:type", content: "website" },
      { name: "twitter:card", content: "summary_large_image" },
    ],
  }),
  component: Index,
});

function Field({
  icon: Icon,
  label,
  value,
}: {
  icon: React.ComponentType<{ className?: string }>;
  label: string;
  value: string | null;
}) {
  return (
    <div className="panel p-4">
      <div className="flex items-center gap-2 text-xs uppercase tracking-widest text-muted-foreground">
        <Icon className="h-3.5 w-3.5 text-primary" />
        {label}
      </div>
      <p className="mt-2 truncate text-sm text-foreground" title={value ?? undefined}>
        {value ?? "—"}
      </p>
    </div>
  );
}

function Report({ info }: { info: IpInfo }) {
  const location = [info.city, info.region, info.country].filter(Boolean).join(", ") || null;
  const coords =
    info.latitude !== null && info.longitude !== null
      ? `${info.latitude.toFixed(4)}, ${info.longitude.toFixed(4)}`
      : null;

  return (
    <section className="space-y-4">
      <div className="panel glow relative overflow-hidden p-6 sm:p-8">
        <div className="pointer-events-none absolute -right-24 -top-24 h-64 w-64 rounded-full border border-primary/30">
          <div className="radar-sweep h-full w-full origin-center rounded-full bg-[conic-gradient(from_0deg,transparent_0%,var(--signal)_12%,transparent_20%)] opacity-20" />
        </div>
        <p className="text-xs uppercase tracking-[0.3em] text-muted-foreground">Target address</p>
        <h2 className="mt-2 font-mono text-3xl font-semibold text-primary sm:text-4xl">{info.ip}</h2>
        <p className="mt-3 flex items-center gap-2 text-sm text-foreground">
          <span className="text-lg leading-none">{info.flag ?? "🌐"}</span>
          {location ?? "Location unavailable"}
        </p>
      </div>

      <div className="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <Field icon={Wifi} label="ISP" value={info.isp} />
        <Field icon={Signal} label="Organization" value={info.org} />
        <Field icon={Hash} label="ASN" value={info.asn} />
        <Field icon={MapPin} label="Coordinates" value={coords} />
        <Field icon={Clock} label="Timezone" value={info.timezone} />
        <Field icon={Clock} label="Local time" value={info.localTime} />
        <Field icon={Globe} label="IP version" value={info.type} />
        <Field icon={MapPin} label="Postal code" value={info.postal} />
        <Field icon={Globe} label="Country code" value={info.countryCode} />
      </div>

      {coords && (
        <a
          className="inline-flex items-center gap-2 text-sm text-primary underline-offset-4 hover:underline"
          href={`https://www.openstreetmap.org/?mlat=${info.latitude}&mlon=${info.longitude}#map=10/${info.latitude}/${info.longitude}`}
          target="_blank"
          rel="noreferrer"
        >
          <MapPin className="h-4 w-4" /> View approximate location on map
        </a>
      )}
    </section>
  );
}

function Index() {
  const [query, setQuery] = useState("");
  const lookup = useServerFn(lookupIp);

  const mine = useQuery({
    queryKey: ["my-ip"],
    queryFn: () => getMyIp(),
    staleTime: 5 * 60 * 1000,
  });

  const search = useMutation({
    mutationFn: (value: string) => lookup({ data: { query: value } }),
  });

  const result = search.data?.data ?? (search.isPending ? null : mine.data?.data ?? null);
  const error = search.data?.error ?? (search.isError ? "Lookup failed" : mine.data?.error ?? null);
  const loading = mine.isLoading || search.isPending;

  return (
    <main className="mx-auto w-full max-w-5xl px-5 py-14 sm:py-20">
      <header className="mb-10">
        <p className="flex items-center gap-2 text-xs uppercase tracking-[0.35em] text-primary">
          <Signal className="h-3.5 w-3.5" /> live trace
        </p>
        <h1 className="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">IP Tracker</h1>
        <p className="mt-3 max-w-xl text-sm leading-relaxed text-muted-foreground">
          Your public IP is detected automatically. Enter any other IP address or domain to trace its
          network, location and timezone.
        </p>
      </header>

      <form
        className="mb-10 flex flex-col gap-3 sm:flex-row"
        onSubmit={(e) => {
          e.preventDefault();
          if (query.trim()) search.mutate(query.trim());
        }}
      >
        <Input
          value={query}
          onChange={(e) => setQuery(e.target.value)}
          placeholder="8.8.8.8 or example.com"
          aria-label="IP address or domain"
          className="h-12 font-mono text-base"
        />
        <Button type="submit" size="lg" className="h-12 gap-2" disabled={search.isPending}>
          {search.isPending ? (
            <Loader2 className="h-4 w-4 animate-spin" />
          ) : (
            <Search className="h-4 w-4" />
          )}
          Trace
        </Button>
      </form>

      {loading && !result && (
        <p className="flex items-center gap-2 text-sm text-muted-foreground">
          <Loader2 className="h-4 w-4 animate-spin" /> Tracing…
        </p>
      )}

      {error && !result && (
        <p className="panel border-destructive/50 p-4 text-sm text-destructive">{error}</p>
      )}

      {result && <Report info={result} />}
      {result && error && <p className="mt-4 text-sm text-destructive">{error}</p>}
    </main>
  );
}




