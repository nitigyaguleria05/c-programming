import { createServerFn } from "@tanstack/react-start";

export type IpInfo = {
  ip: string;
  type: string | null;
  city: string | null;
  region: string | null;
  country: string | null;
  countryCode: string | null;
  flag: string | null;
  latitude: number | null;
  longitude: number | null;
  postal: string | null;
  timezone: string | null;
  utcOffset: string | null;
  localTime: string | null;
  isp: string | null;
  org: string | null;
  asn: string | null;
};

type WhoIsResponse = {
  success?: boolean;
  message?: string;
  ip?: string;
  type?: string;
  city?: string;
  region?: string;
  country?: string;
  country_code?: string;
  latitude?: number;
  longitude?: number;
  postal?: string;
  flag?: { emoji?: string };
  connection?: { asn?: number; org?: string; isp?: string };
  timezone?: { id?: string; utc?: string; current_time?: string };
};

function normalize(raw: WhoIsResponse): IpInfo {
  return {
    ip: raw.ip ?? "unknown",
    type: raw.type ?? null,
    city: raw.city ?? null,
    region: raw.region ?? null,
    country: raw.country ?? null,
    countryCode: raw.country_code ?? null,
    flag: raw.flag?.emoji ?? null,
    latitude: typeof raw.latitude === "number" ? raw.latitude : null,
    longitude: typeof raw.longitude === "number" ? raw.longitude : null,
    postal: raw.postal ?? null,
    timezone: raw.timezone?.id ?? null,
    utcOffset: raw.timezone?.utc ?? null,
    localTime: raw.timezone?.current_time ?? null,
    isp: raw.connection?.isp ?? null,
    org: raw.connection?.org ?? null,
    asn: raw.connection?.asn ? `AS${raw.connection.asn}` : null,
  };
}

async function lookup(ip?: string): Promise<{ data: IpInfo | null; error: string | null }> {
  try {
    const url = ip ? `https://ipwho.is/${encodeURIComponent(ip)}` : "https://ipwho.is/";
    const res = await fetch(url, { headers: { accept: "application/json" } });
    if (!res.ok) return { data: null, error: "Lookup service unavailable" };
    const raw = (await res.json()) as WhoIsResponse;
    if (raw.success === false) {
      return { data: null, error: raw.message ?? "That IP address could not be found" };
    }
    return { data: normalize(raw), error: null };
  } catch {
    return { data: null, error: "Lookup service unavailable" };
  }
}

/** Geolocate the visitor's own public IP (resolved from request headers). */
export const getMyIp = createServerFn({ method: "GET" }).handler(async () => {
  const { getRequestHeader } = await import("@tanstack/react-start/server");
  const forwarded = getRequestHeader("x-forwarded-for") ?? "";
  const candidate =
    forwarded.split(",")[0]?.trim() ||
    getRequestHeader("cf-connecting-ip") ||
    getRequestHeader("x-real-ip") ||
    "";
  const isPrivate =
    !candidate ||
    candidate.startsWith("127.") ||
    candidate.startsWith("10.") ||
    candidate.startsWith("192.168.") ||
    candidate === "::1";
  return lookup(isPrivate ? undefined : candidate);
});

/** Geolocate any IP address or hostname. */
export const lookupIp = createServerFn({ method: "POST" })
  .inputValidator((input: { query: string }) => ({ query: String(input.query ?? "").trim() }))
  .handler(async ({ data }) => {
    if (!data.query) return { data: null, error: "Enter an IP address or domain" };
    if (data.query.length > 253) return { data: null, error: "That input is too long" };
    return lookup(data.query);
  });        



